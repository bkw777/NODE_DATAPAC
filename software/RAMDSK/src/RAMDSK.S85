; Assembly source for RAMDSK.CO
; Brian K. White
; Originally from disassembly of RAM100.CO v2 & RAM200.CO v2 by Paul Globman
;
; Compile:
;   z88dk-z80asm -m8085_strict -no-synth -DMODEL_100 -b -o=RAM100.CO RAMDSK.S85 && \
;   z88dk-z80asm -m8085_strict -no-synth -DMODEL_100 -DPRGLEN=$(wc -c <RAM100.CO) -b -o=RAM100.CO RAMDSK.S85
;
; Original legacy binaries:
; https://www.club100.org/library/libpg.html "pgnode" section
; https://ftp.whtech.com/club100/pg/pgnode/node1/ram100.co		RAM100.CO  (v2 that supports banks)
; https://ftp.whtech.com/club100/pg/pgnode/node2/ramdsk.co		RAM200.CO  (v1 that does not support banks)
; https://www.club100.org/library/libeme.html "RAMPAC files..." section
; https://ftp.whtech.com/club100/eme/r200ld.200 (BASIC loader)  RAM200.CO  (v2 that supports banks)
;
; rom maps & other dev support
; https://github.com/bkw777/m100_dev
;
; [export] comments mark certain functions for the Makefile to
; extract from the .map file to write .calls file.
;
; [variable_name] comments mark the special variables where the address of the
; operand of that instruction is the actual address of the indicated variable.
; It means the value in the source is just the initial condition and that the
; byte or word gets overwritten while running.
;
; disk address convention used sometimes below:
; n1k2b3 = bank 1, block 2, byte 3
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; CONFIG
;------------------------------------------------------------------------------

	IF DEBUG
	UNDEFINE MATCH_LEGACY_CO_HEADER
	ENDIF

	;DEFINE BANKS_ONE_BASED

;------------------------------------------------------------------------------
; ASSEMBLER
;------------------------------------------------------------------------------

; z88dk before db5c165 doesn't recognize the intel syntax for RST
_RST MACRO n
	IF Z88DK && Z88DK<25000
		RST n*8
	ELSE
		RST n
	ENDIF
	ENDM

;------------------------------------------------------------------------------
; PLATFORM
;------------------------------------------------------------------------------

	IF MODEL_200
	INCLUDE		"200.S85"
	ELIF MODEL_K85
	INCLUDE		"K85.S85"
	ELIF MODEL_M10
	INCLUDE		"M10.S85"
	ELSE
	INCLUDE		"100.S85"
	ENDIF

; cpu opcodes
opcode_IN				EQU		0xDB
opcode_OUT				EQU		0xD3

KC6						EQU		KYDATA+6	; keyb col 6 / PA6 bits 0-7: SPACE,DEL,TAB,ESC,PASTE,LABEL,PRINT,ENTER
KC7						EQU		KYDATA+7	; keyb col 7 / PA7 bits 0-7: F1-F8

; ascii
LF						EQU		0x0A
FF						EQU		0x0C
CR						EQU		0x0D
ESC 					EQU		0x1B

; vt52/screen control sequences
; the macro names match the terminfo field names
clr_eol MACRO
		DB ESC,'K'
	ENDM
cursor_address MACRO row,col
		DB ESC,'Y',row+31,col+31
	ENDM
disable_automatic_scroll MACRO
		DB ESC,'V'
	ENDM
cursor_normal MACRO
		DB ESC,'P'
	ENDM
cursor_invisible MACRO
		DB ESC,'Q'
	ENDM
enter_reverse_mode MACRO
		DB ESC,'p'
	ENDM
exit_attribute_mode MACRO
		DB ESC,'q'
	ENDM
unprotect_labels MACRO
		DB ESC,'U'
	ENDM


; MKDIRENT file attributes
attrBA					EQU		0x80			; .BA file
attrDO					EQU		0xC0			; .DO file
attrCO					EQU		0xA0			; .CO file

BASE_LEN				EQU		6				; filename basename length
EXT_LEN					EQU		2				; filename extension length
CKFN_LEN				EQU		BASE_LEN + EXT_LEN	; fname len after CKFN

FX1						EQU		FILNM1+BASE_LEN	; start of EXT of FILNM1 after CKFN
FX2						EQU		FILNM2+BASE_LEN	; start of EXT of FILNM2 after CKFN

rst_Print_A				EQU		4				; RST 4 = print A to LCD/LPT
PRTSPC					EQU		0x001E			; write space to console, directed by LCDLPT
CPHLdn					EQU		ESCB+8			; CSRYX Y=L++ X=H
CPHL					EQU		ESCB+9			; CSRYX Y=L X=H

	IFNDEF NROWS
NROWS					EQU		8				; LCD screen rows
	ENDIF
NFNAMES					EQU		(NROWS-3)*2		; number of filenames per screen

	IFNDEF BAFILES
BAFILES					EQU		UNSAVBA			; start of BA files - RAM100 uses UNSAVBA, RAM200 uses CURBAS
	ENDIF

	IFNDEF LEGACY_HIMEM
LEGACY_HIMEM			EQU		0xF5EE			; HIMEM=0xF5EE matches the legacy RAM100.CO v2
	ENDIF

	IFNDEF ALTLCD
ALTLCD					EQU		0xFCC0			; start of ALT LCD buffer, 320 bytes
	ENDIF

	IFNDEF MAXRAM
MAXRAM					EQU		0xF5F0
	ENDIF

	IFNDEF DeleteRamFile
DeleteRamFile MACRO
		CALL			FINDFN1					; tail end of FINDFN
		CPI				attrDO
		JZ				KILASC					; if it's a .DO file
		CPI				attrCO
		JZ				KILCOM					; if it's a .CO file
		JMP				KILBAS					; if it's anything else
	ENDM
	ENDIF

;------------------------------------------------------------------------------
; DATAPAC/RAMPAC
;------------------------------------------------------------------------------
CTRL_PORT				EQU		0x81			; control port for bank 0
DATA_PORT				EQU		0x83			; data read/write port
CTRL_STEP				EQU		0x04			; bank n ctl port is ctl0 + n*4

DBLOCK_LEN				EQU		0x0400			; disk block length

;------------------------------------------------------------------------------
; APPLICATION
;------------------------------------------------------------------------------

; Format Stamp - or "fcb 0"
;
; StampByte0 = attrNA
; Aside from being part of the the stamp marking the entire device as formatted
; or "used by RAMDSK", it also serves the same function as on any other normal FCB.
; It marks block 0 as occupied, but not by any BA/CO/DO file,
; the same as for blocks above 128k that don't exist on 128k devices.
;
; StampByte1 = 0x04
; Does NOT mean "next block in this file is block 4".
; To RAMDSK it's an arbitrary value with no meaning, we just always write 4 and
; always expect to read 4, to maintain compatibility with the NODE ROM.
; It might possibly have some meaning to the NODE ROM. The NODE ROM does more
; than RAMDSK does, including supposedly being able to use PCSG and PG Designs
; ram expansions, which are different types of hardware that don't work the way
; that a RAMPAC works. Maybe it indicates the type of hardware or formatting.
StampByte0				EQU		attrNA
StampByte1				EQU		0x04

attrFD					EQU		' '				; file data, part of a file after the first block
attrNA					EQU		0x40			; not-applicable / not-available, block that can not be used for a file

MinRam					EQU		0x80			; threshold for installed ram amount test

DFHDR					EQU		ALTLCD
DFSZ_LEN				EQU		2
DFHDR_LEN				EQU		CKFN_LEN + DFSZ_LEN	; disk header len
DFSZ					EQU		DFHDR+CKFN_LEN	; disk file size

	IF BANKS_ONE_BASED
FIRST_BANK_asc			EQU		'1'				; display bank numbers as Bank1 - Bank4
	ELSE
FIRST_BANK_asc			EQU		'0'				; display bank numbers as Bank0 - Bank3
	ENDIF
MAX_BANKS_asc			EQU		'4'				; max nbanks

; variables defined as the address to the operand of a load instruction
; (saves space, The filesize is reduced by the combined size of all of these)
initial_sp				EQU		MAIN+1				; initial stack pointer
strBankNum				EQU		strTitle+24			; bank number ascii
ctl_port				EQU		SelectBlock+1		; rampac control port number
dfnum					EQU		NextDF+1			; disk file number
pending_fname_bytes		EQU		ListFiles@brc+1		; fname bytes remaining loop counter
FreeKB					EQU		SetFBlocks@freekb+1	; free KB disk space
fstart					EQU		CopyBlocks@l1+1		; new ram file start addr
attr					EQU		FindFILNM1onDisk@fileattr+1		; file attr byte
TmpBlockNum				EQU		FCB_NextBlock+1		; tmp block number
BlockNum				EQU		GetNextBlock@bn+1	; block number
NextBlock				EQU		GetNextBlock@nb+1
fblocks					EQU		ClaimFCB+1			; number of blocks used by a file
pending_block_bytes		EQU		CopyBlocks@pbb+1

	IF DEBUG
NUM_BANKS_asc			EQU		strBankNum+3		; store right on screen for debug
	ELSE
NUM_BANKS_asc			EQU		BANK@nbanks+1		; store in MVI operand
	ENDIF


;------------------------------------------------------------------------------
; ORG
;------------------------------------------------------------------------------

; If PRGLEN is not supplied from the commandline via -D,
; then just compile with no header or org.
; Makefile compiles once with no ORG or .CO header just to get the length,
; then compiles again with -DPRGLEN=num.
; Supply -DHIMEM=num to generate a relocated binary.
	IFDEF PRGLEN
	;--------------------------------------------------------------------------
	; ORG
	;--------------------------------------------------------------------------
	IFNDEF HIMEM
	IF MATCH_LEGACY_CO_HEADER
HIMEM					EQU		LEGACY_HIMEM
	ELSE
HIMEM					EQU		MAXRAM
	ENDIF
	ENDIF ; HIMEM

	ORG HIMEM-PRGLEN-6					; entry minus length of header

	;--------------------------------------------------------------------------
	; .CO HEADER
	;--------------------------------------------------------------------------
	DW PRGTOP	; top
	DW PRGLEN	; len
	DW PRGEXE	; exe
	ENDIF ; PRGLEN

;------------------------------------------------------------------------------
; START
;------------------------------------------------------------------------------

PRGTOP:
PRGEXE:
		LDSI	0						; DE = stack pointer+0
		XCHG							; HL = stack pointer
		SHLD	initial_sp				; initial_sp = stack pointer before we start
		CALL	Find_NUM_BANKS			; probe the hardware to find how many banks

MAIN:
		LXI		SP,0					; [initial_sp]  SP = initial_sp  reset stack pointer to initial addr on each return to main
		LXI		H,MAIN					; HL = MAIN
		PUSH	H						; TS = MAIN
		SHLD	ETRAP					; set MAIN as error handler
		LXI		H,FILNM1				; HL = FILNM1
		MVI		M,' '					; write a space to the 1st byte of FILNM1
		CALL	DrawUI					; draw the title & initial screen
		STA		dfnum					; dfnum = 0  disk filename number  (PTILL0 leaves A=0)
		MVI		D,attrBA				; D = attrBA
		CALL	ListFiles				; print all BA filenames to screen
		MVI		D,attrCO				; D = attrCO
		CALL	ListFiles				; print all CO filenames to screen
		MVI		D,attrDO				; D = attrDO
		CALL	ListFiles				; print all DO (or just all) filenames to screen

MAIN1:
		CALL	FREE

; Fkeys
; Bank Load Save Name Kill ---- ---- Menu
; F1   F2   F3   F4   F5   F6   F7   F8

ReadKeyboard:
		CALL	KYREAD					; look for keypress
		JC		ProcessSpecialKey		; carry -> fkey
		JZ		ReadKeyboard			; z -> no key -> read again

ProcessNormalKey:
		CPI		CR						; A == Enter?
		; Sometimes we did not get here via CALL, and RZ goes to MAIN from PUSH HL=MAIN
		; Sometimes we got here via CALL from NextDF, and RZ returns there
		RZ								; return or MAIN if CR
		JMP		ReadKeyboard			; read keyboard again if not CR

ProcessSpecialKey:
		LXI		H,MAIN					; HL = MAIN
		PUSH	H						; TS = MAIN, makes the RET at the end of the target routines go to MAIN
		CPI		0xFF
		JZ		SAVE1					; save file without displaying file list

	IF DEBUG
		ADI		'0'
		STA		DBG_K
		SUI		'0'
	ENDIF

; F1
		ANA		A						; A=key=0 = F1
		JZ		BANK
; F2
		DCR		A						; A-- key=1 = F2
		JZ		LOAD
; F3
		DCR		A						; A-- key=2 = F3
		JZ		SAVE
; F4
		DCR		A						; A-- key=3 = F4
		JZ		NAME
; F5
		DCR		A						; A-- key=4 = F5
		JZ		KILL
; F6
;		DCR		A						; A-- key=5 = F6
;		JZ		F6
; F7
;		DCR		A						; A-- key=6 = F7
;		JZ		F7
; F8
;		DCR		A						; A-- key=7 = F8
		SUI		3						; A-=3 key=7 = F8
		JZ		MENU
; LABEL
		DCR		A						; A-- key=8 = LABEL
		JZ		FORMAT

		POP		H						; HL = MAIN
		JMP		ReadKeyboard

;------------------------------------------------------------------------------
; ListFiles - Scan FCB table for attr=D, print filename & filesize
;------------------------------------------------------------------------------
;
; FCB is File Control Block.
;
; Each FCB is 2 bytes:
; 0: attribute
; 1: next block
;
; FCB table is block 0 bytes 2-511
;
; Each FCB corresponds to a disk block.
; fcbs 1-255 correspond to blocks 1-255.
;
; You could also say the format stamp in bytes 0-1 is "fcb 0" for block 0, the FCB table itself.
;
; That's only 512 bytes. The second 512 bytes of block 0 are unused.
; Maybe we can put some cool bootstrap code there and make BASIC code to load
; it that's smaller and simpler than RBOOT?
;
; ReadStamp moves to block 0 and reads the format stamp,
; leaving the disk at block 0 byte 2, which is the start of the FCB table.
; Starting from there, read bytes in pairs, for 255 pairs.
;
; We enter with D = attrBA or attrCO or attrDO
; C is the loop counter = fcb/block number
; At each each pair:
; * if attr != D then skip the rest and get next fcb
; * advance cursor to next screen position
; * move disk to block C byte 0
; * read 10 bytes fname & fsize and print to screen
;
; dfnum is set to 0 once initially but advances with each pass
; D = attrBA / attrCO / attrDO
ListFiles:
		; move to start of fcb table
		CALL	ReadStamp				; disk @ k0b2
		MVI		C,1						; C = 1  fcb/block number
		; read FCBs until C++ rolls over to 0
@read_fcb:								; read one FCB (2 bytes)
		CALL	ReadBA					; B=attr  A=next
		MOV		A,B						; A=attr
		CMP		D						; if attr==D ...
		CZ		@read_file_header		; ... then CALL @read_file_header
		INR		C						; C++ next FCB
		JNZ		@read_fcb				; repeat until all 255 possible pairs have been checked
		RET								; return when C rolls through FF back to 0

@read_file_header:
		PUSH	D						; push D=attr E=?
		PUSH	B						; push B=attr C=block
		MOV		A,C						; A = block
		CALL	SelectBlock				; disk @ kCb0  move disk to block C byte 0
		CALL	AdvanceCursor			; move LCD cursor to the next filename screen position
		; read the filename & size from disk and print to screen
		; disk is currently at block C byte 0
@read_and_print_byte:
		IN		DATA_PORT				; A = kCbN   read the byte from disk at block C byte 0-7
		_RST	rst_Print_A				; print it to screen
		; NRAP = convoluted way to write "8", but I want to document why it's 8
		; This counter starts at 8 and processes a filename, but it's not counting 6+2, it's 6-1+1+2.
		; We read 8 bytes from disk BBBBBBEE
		; We print 9 bytes to screen BBBBBB.EE
		; The counter is counting the remaining bytes to print to screen.
		; We print 9 bytes but the counter starts at 8 because we already did the first B.
		; Now we need to read & print 5 more B, then generate dot, then read & print 2 E.
		; Counter = 6-1 + 1 + 2 = 8  Dot happens at 2(ext bytes remaining) + 1(dot remaining) = 3(bytes remaining)
NRAP EQU BASE_LEN-1+1+EXT_LEN			; number to read-and-print
@brc:
		MVI		A,NRAP					; [pending_fname_bytes] A = pending_fname_bytes
		CPI		1+EXT_LEN				; Z if pending_fname_bytes = 3
		JNZ		@next_fname_byte		; skip to @next_fname_byte unless pending_fname_bytes = 3
		PUSH	PSW						; stash A=pending_fname_bytes
		MVI		A,'.'					; A = '.'
		_RST	rst_Print_A				; print '.'
		POP		PSW						; restore A=pending_fname_bytes
@next_fname_byte:
		DCR		A						; A--
		STA		pending_fname_bytes		; pending_fname_bytes--
		JNZ		@read_and_print_byte	; repeat read&print until pending_fname_bytes=0
		; done reading & printing filename
		; reset the counter
		MVI		A,NRAP					; A = 8
		STA		pending_fname_bytes		; pending_fname_bytes = 8
		PUSH	B						; push B = pending_fname_bytes = 8
		; read the filesize from disk
		IN		DATA_PORT				; A = filesize lsb
		MOV		L,A						; L = filesize lsb
		IN		DATA_PORT				; A = filesize msb
		MOV		H,A						; H = filesize msb
		; HL=filesize
		; print 2 spaces after the filename
		CALL	PRTSPC					; print a space
		CALL	PRTSPC					; print a space
		; print the filesize to screen
		CALL	PRTASC					; print the filesize as ascii
		CALL	NextDF					; incr or roll over dfnum
		POP		B						; restore B = pending_fname_bytes = 8
		; done printing the complete filename and file size
		; return to block 0
		CALL	ReadStamp				; disk @ k0b2
		; seek to the current FCB
		CALL	ReadBAxC				; read C pairs (seek to current/next FCB in block 0)
		POP		B						; restore B=attr  C=block
		POP		D						; restore D=attr  E=?
		RET

; Move cursor to the next filename display position
; If dfnum is even, move cursor left to column 4 and down one row.
; if dfnum is odd, move cursor right to column 24 on the same row.
AdvanceCursor:
		LHLD	CSRYX					; H = cursor X, L = cursor Y
		LDA		dfnum					; A = dfnum
		ANI		1						; Z if dfnum is even
		JNZ		@l0						; if dfnum is odd then jump @l0
		; dfnum is EVEN
		MVI		H,4						; H = column 4
		; move the cursor to row++ , col 4 , return
		JMP		CPHLdn					; cursor position CSRYX=HL++
@l0:
		; dfnum is ODD
		MVI		H,24					; H = column 24
		; move the cursor to col 24 , return
		JMP		CPHL					; cursor position CSRYX=HL

; next disk file / incriment dfnum
; if we filled the screen then wait for Enter & start new screen
NextDF:
		MVI		A,0						; [dfnum] A = dfnum
		INR		A						; A++
		STA		dfnum					; dfnum++
		CPI		NFNAMES					; compare dfnum to NFNAMES
		RNZ								; if not NFNAMES, return
		; dfnum passed end of screen, screen is filled
		; reset dfnum and wait for keypress
		XRA		A						; A = 0
		STA		dfnum					; dfnum = 0
		CALL	MAIN1					; FREE then ReadKeyboard
		; Screen is still displaying a screeen full of filenames.
		; Waiting for keypress. If it's Enter, ReadKeyboard will return here.
		; Relies on falling through to DrawUI to clear the old screen.
DrawUI:
		LXI		H,strUI					; HL @ strUI
		JMP		PTILL0					; print strUI to screen (includes FF to clear the screen)

;------------------------------------------------------------------------------
; FREE - Update FreeKB
;------------------------------------------------------------------------------
; Each block is a k so we just walk the fcb table and add 1 k per free fcb.
FREE:									; [export] Scan disk & update free space.
		PUSH	H						; push HL
		PUSH	D						; push DE
		PUSH	B						; push BC
		PUSH	PSW						; push AF
		XRA		A						; A = 0
		MOV		D,A						; D = 0    (E still whatever)
		MOV		H,A						; H = 0
		MOV		L,A						; L = 0    HL = 0  = free blocks = 0
		CALL	SelectBlock				; disk @ k0b0
		; Starting at byte0, not technically at the start of fcb table, but the
		; stamp will always make "fcb0"/block0 look occupied and skipped over.
@read_fcb:
		CALL	ReadBA					; read 2 bytes into B & A
		ORA		B						; are both bytes 0?
		JNZ		@next_fcb				; if either byte >0 then skip to @l1
		; both bytes in this fcb are 0, add 1 to free blocks
		INX		H						; HL++ = free blocks++
@next_fcb:
		DCR		D						; D-- (not DE, and started at 0, so D=FF or less)
		JNZ		@read_fcb				; repeat until D=0 (255 times)
		; done reading all 255 fcbs - update FreeKB
		PUSH	H						; stash HL=free blocks tally
		LXI		H,strFree				; HL @ strFree (really just the escape sequences to position the cursor)
		CALL	PTILL0					; print strFree (really just moves the cursor to the spot where free blocks goes)
		POP		H						; restore HL = free blocks tally
		MOV		A,L						; A = free blocks lsb (which is the whole value since it can't go over 255)
		STA		FreeKB					; FreeKB = A = free blocks tally
		CALL	PRTASC					; print A (free KB) as ascii
		JMP		POPALL					; restore all pushed at start, return

;------------------------------------------------------------------------------
; KILL - delete a file on disk
;------------------------------------------------------------------------------
KILL:									; [export] Delete a file on disk.
		; get the filename from the user
		LXI		H,strKill				; HL @ strKill
		CALL	Ask_Disk_Filename		; print prompt & get fname from user
		JNZ		BEEP					; invalid input beep & return
		; filename was found on disk
		; FILNM1 contains filename reformatted by CKFN
		; confirm ok to delete
		CALL	ConfirmSure				; print are you sure & get Y from user
		RNZ								; if not Y then return now
@l0:
		CALL	ReadStamp				; disc @ k0b2
		LDA		BlockNum				; A = BlockNum
		DCR		A						; A--
		JZ		@l1						; if BlockNum-1 = 0 then we are already on the right FCB, skip seeking
		MOV		C,A						; C = BlockNum-1
		CALL	ReadBAxC				; seek to start of BlockNum
		; ReadBAxC with C=BlockNum-1 reads up to and including FCB BlockNum-1,
		; leaving the disk on the start of FCB BlockNum.
@l1:
		; write 0x00 0x00 over FCB BlockNum
		XRA		A						; A = 0
		OUT		DATA_PORT				; write 0x00
		OUT		DATA_PORT				; write 0x00
		;
		LDA		NextBlock				; A = NextBlock
		ANA		A						; Z if NextBlock = 0
		RZ								; if NextBlock=0 then return  (no more blocks to clear)
		; NextBlock > 0
		STA		BlockNum				; BlockNum = NextBlock
		MOV		C,A						; C = BlockNum
		CALL	ReadStamp				; disk @ k0b2, A = 0x44
		CALL	ReadBAxC				; seek to and read FCB for BlockNum, B=fcb_attr, A=fcb_nextblock
		STA		NextBlock				; NextBlock = fcb_nextblock from BlockNum
		JMP		@l0

;------------------------------------------------------------------------------
; NAME
;------------------------------------------------------------------------------
; Get source & dest filenames from user, find source on disk
; rewrite name with dest.
NAME:									; [export] Rename a file on disk.
		LXI		H,strName				; HL @ strName
		CALL	Ask_Disk_Filename		; get source fname from user into FILNM2
		JNZ		BEEP					; if invalid, beep & return
		CALL	Ask_Dest_Filename		; get destination fname from user into FILNM1
		LDA		BlockNum				; A = BlockNum
		MOV		B,A						; B = BlockNum
		PUSH	B						; stash B=BlockNum C=?
		CALL	FindFILNM1onDisk		; if FILNM1(dest) exists on disk then copy to FILNM2
		POP		B						; restore B=BlockNum C=?
		JZ		BEEP					; abort if FILNM1(dest) exists? not-exists? empty input?
		MOV		A,B						; A = B = BlockNum
		CALL	SelectBlock				; move disk to BlockNum byte 0
		LXI		H,FILNM1				; HL @ FILNM1(dest)
		MVI		B,BASE_LEN				; B = 6 bytes file base name
@l0:
		MOV		A,M						; A = byte @ HL
		OUT		DATA_PORT				; write byte to disk, disk++
		INX		H						; HL++
		DCR		B						; B--
		JNZ		@l0						; next byte until B==0
		RET

ConfirmReplace:
		LXI		H,strReplace
		CALL	ConfirmWithPrompt
		JNZ		MAIN
		RET

ConfirmReplaceKill:
		CALL	ConfirmReplace
		JMP		KILL@l0

;------------------------------------------------------------------------------
; SAVE
;------------------------------------------------------------------------------
SAVE:
		MVI		A,FF					; A = FormFeed
		_RST	rst_Print_A				; print FF (clear the screen)
		CALL	FILES					; display ram files list
SAVE1:									; [export] 
		LXI		H,strSave				; HL = strSave
		CALL	InputFilenameWithPrompt	; display strSave and get username from user into FILNM1
		CALL	FINDFN					; find FILNM1(source) in ram, Z if not found
		JZ		BEEP					; abort if not found
		; HL=dirent DE=data A=attr
		PUSH	H						; save HL=dirent
		; preload dest filename with src filename so user can just press enter to accept default
		CALL	FILNM1toFILNM2			; copy FILNM1 to FILNM2, destroyed HL, DE, A, B
		CALL	Ask_Dest_Filename		; get destination filename from user into FILNM1
		CALL	FindFILNM1onDisk		; find FILNM1(dest) on disk, copy to FILNM2
		CZ		ConfirmReplaceKill		; if it exists, then confirm ok to replace
		CALL	FREE					; update FreeKB
		POP		H						; retore HL = src_dirent
		INX		H						; HL++
		XCHG							; DE = src_dirent+1
		LHLX							; HL = word@src_dirent+1  (HL=file_addr)
		SHLD	fstart					; fstart = HL
		CALL	GetRamFSize				; HL = filesize-1
		INX		H						; HL = filesize
		CALL	FillDFHeader			; fill disk file header buffer: FILNM1->DFHDR, filesize->DFSZ 
		CALL	CountFileBlocks			; Get the number of disk blocks required to hold the file
		CALL	ClaimFileBlocks			; Find available blocks and claim them
		CALL	CopyRamFileDataToDisk	; Copy the file data from ram to disk
		RET

GetRamFSize:
		; HL = fstart
		LDA		attr					; A = attr
		CPI		attrBA
		JZ		GetRamBASize			; if it's a BA file, GOTO GetRamBASize
		CPI		attrDO
		JZ		GetRamDOSize			; if it's a DO file, GOTO GetRamDOSize
		; it's a CO file
		LDHI	2						; DE = HL+2 (start of LEN pair in CO header)
		LHLX							; HL = filesize (not including 6-byte CO header)
		; artificially mimic the HL=filesize-1 that the BA and DO routines produce
		LXI		D,5						; DE = 5 (6-byte CO header - 1)
		DAD		D						; HL += 5 = full filesize including CO header - 1
		; HL = fsize-1
		RET

GetRamDOSize:
		PUSH	H
		CALL	GETEOF
		POP		B
		DSUB
		; HL = fsize-1
		; we JMP'd here, so we are returning all the way out of GetRamFSize back to SAVE1
		RET

GetRamBASize:
		PUSH	H						; push HL = fstart
		CALL	UBLLL+3					; update BASIC line number addresses, skip initial LHLD
		; HL = addr last byte in file
		POP		B						; pop HL=fstart to BC
		DSUB							; HL -= BC  HL = last-first
		; HL = fsize-1
		; we JMP'd here, so we are returning all the way out of GetRamFSize back to SAVE1
		RET

FillDFHeader:
		SHLD	DFSZ					; DFSZ = HL
		LXI		H,DFHDR					; HL @ DFHDR
		JMP		FILNM1toHL				; copy FILNM1 to DFHDR

; Count how many blocks the file will require.
; The first block (of the file) only has 1014 bytes available for
; file data because 10 bytes are consumed by the disk file header.
CountFileBlocks:
		LHLD	DFSZ					; HL = DFSZ = filesize
		MVI		D,1						; D = 1  fblocks = 1
		LXI		B,DBLOCK_LEN-DFHDR_LEN	; BC = block_len-header_len
		JMP		AddFBlock1				; 

; Subtract 1 block (1024 bytes) from filesize
; Add 1 to fblocks
; HL = remaining fsize
AddFBlock:
		LXI		B,DBLOCK_LEN			; BC = 1024 full size block
; alt entry with BC set to some other value than 1024
AddFBlock1:
		DSUB							; HL = fsize-BC
		JZ		SetFBlocks				; if HL==0
		JM		SetFBlocks				; if HL<0
		INR		D						; D++  (fblocks++)
		JMP		AddFBlock				; next fblock

SetFBlocks:
		MOV		A,D						; A = D = fblocks
		STA		fblocks					; fblocks = A
@freekb:
		MVI		A,0						; [FreeKB]  A = FreeKB
		CMP		D						; FreeKB vs fblocks
		RNC								; If FreeKB>=fblocks then return OK
		; If FreeKB<fblocks then out of space error
POP_BEEP:
		POP		PSW
		JMP		BEEP

; Walk FCB and claim available blocks for a file.
ClaimFileBlocks:
		CALL	ReadStamp				; move to start of FCB table
		MVI		C,0						; C = 0  FCB/block number - 1
@read_fcb:
		CALL	ReadBA					; read FCB  B=attr A=nextblock
		INR		C						; C++
		ORA		B						; if either B>0 or A>0
		JNZ		@read_fcb				; FCB/block is occupied, try next FCB
		; both B and A are 0, this FCB/block is unoccupied, claim it
		; move back to the start of the current FCB so ClaimFCB can write it
		CALL	SelectBlock				; move to block 0 byte 0
		MOV		A,C						; A = C  (current FCB/block number)
		STA		BlockNum				; update BlockNum = A = C
		CALL	ReadBAxC				; read C pairs of bytes (move disk form byte 0 up to start of FCB C)
		CALL	ClaimFCB				; claim this FCB (write attr & next)
		LDA		BlockNum				; A = BlockNum
		STA		TmpBlockNum				; TmpBlockNum = A
		JMP		ClaimFileBlocks

ClaimFCB:
		MVI		A,0						; [fblocks]  A = fblocks
		DCR		A						; A--
		STA		fblocks					; fblocks = A
		JZ		WriteHeadFCB			; when we get to block 0 write the head FCB
		; not a file-head block, write a file-cont FCB
		MVI		A,attrFD				; A = ' '
		OUT		DATA_PORT				; write FCB_attr field = ' '
		JMP		FCB_NextBlock			; update NextBlock & write FCB_next
; write file-head FCB
WriteHeadFCB:
		POP		PSW						; pop AF  (what pushed?)
		LDA		attr					; A = attr  (discarded pop)
		OUT		DATA_PORT				; write FCB_attr = attr
; update NextBlock and write FCB_next field
FCB_NextBlock:
		MVI		A,0						; [TmpBlockNum] A = TmpBlockNum
		STA		NextBlock				; NextBlock = TmpBlockNum
		OUT		DATA_PORT				; write FCB_next = TmpBlockNum
		RET

; write 10 bytes RAMDSK header to first 10 bytes of block BlockNum
CopyRamFileDataToDisk:
		LDA		BlockNum				; A = BlockNum
		CALL	SelectBlock				; move disk to BlockNum byte 0
		LXI		H,DFHDR					; HL @ DFHDR
		MVI		B,DFHDR_LEN				; B = 10 bytes loop counter
@dfhdr_ram_to_disk:
		MOV		A,M						; A = byte @ HL
		OUT		DATA_PORT				; write A to disk
		INX		H						; HL++
		DCR		B						; B--
		JNZ		@dfhdr_ram_to_disk		; repeat while B>0
		MVI		A,opcode_OUT			; A = opcode_OUT  tell CopyBlocks which direction to move data
		JMP		CopyBlocks				; Proceed to write the actual file data

ConfirmDeleteRamFile:
		PUSH	H
		CALL	ConfirmReplace
		POP		H
		DeleteRamFile

;------------------------------------------------------------------------------
; LOAD
;------------------------------------------------------------------------------
LOAD:
		LXI		H,strLoad				; HL @ strLoad
		CALL	Ask_Disk_Filename		; Display strLoad & get source fname from user
		JNZ		BEEP					; abort if invalid
		CALL	Ask_Dest_Filename		; get destination fname from user into FILNM1
		CALL	FINDFN					; does the dest file already exist in ram?
		CNZ		ConfirmDeleteRamFile	; if so, confirm ok to replace
		CALL	MakeHole				; make space for the new file, HL = COFILES/DOFILES/BAFILES
		SHLD	fstart					; fstart = HL = COFILES/DOFILES/BAFILES
		XCHG							; DE = fstart
		DCX		D						; DE--
		CALL	SCNEMP2					; find empty ram directory entry
		LDA		attr					; A = attr
		CALL	MKDIRENT				; write directory entry
		CALL	ReadBlocks				; read file data from disk to ram
		JMP		RESETFPS				; update file pointers

MakeHole:
		LHLD	DFSZ					; HL = DFSZ
		MOV		B,H						; B = H
		MOV		C,L						; C = L   BC = HL
		LDA		attr					; A = attr
		CPI		attrDO					; does attr = attrDO ?
		JZ		MakeHoleDO				; if yes then goto MakeHoleDO
		CPI		attrBA					; does attr = attrBA ?
		JZ		MakeHoleBA				; if yes then goto MakeHoleBA
		; not DO or BA
MakeHoleCO:
		; A = attr
		LHLD	COFILES					; HL = COFILES
		PUSH	H						; save HL=COFILES
		CALL	MAKHOL					; make the space for the new file
		POP		H						; HL = saved COFILES
		SHLD	COFILES					; COFILES = saved COFILES
		JC		POP_BEEP				; if OOM, pop A & beep (out of memory)
		RET								; HL = COFILES

MakeHoleDO:
		; A = attr
		LHLD	DOFILES					; HL = DOFILES
		CALL	MAKHOL					; make space for the new file
		JC		POP_BEEP				; if OOM, pop A & beep
		RET								; HL = DOFILES

MakeHoleBA:
		; A = attr
		LHLD	BAFILES					; HL = BAFILES
		CALL	MAKHOL					; make space for the new file
		JC		POP_BEEP				; if OOM, pop A & beep
		PUSH	H						; save HL = BAFILES
		CALL	UPDOFILES				; update DOFILES
		POP		H						; HL = saved BAFILES
		RET								; HL = BAFILES

ReadBlocks:
		; for reading from disk to ram we enter here
		MVI		A,opcode_IN				; A = opcode_IN
; CopyBlocks works in both directions, ram-to-disk or disk-to-ram
CopyBlocks:
		; for writing from ram to disk we enter here with A=opcode_OUT
		STA		@inout					; @inout = A = opcode_IN/opcode_OUT
		LXI		H,DBLOCK_LEN-DFHDR_LEN	; first block has 1014 bytes remaining after 10 bytes RAMDSK header
		SHLD	pending_block_bytes		; pending_block_bytes = 1014
		LHLD	DFSZ					; HL = DFSZ
@l1:
		LXI		D,0						; [fstart]  DE = fstart (0 just initial cond)
@move_byte:								; move a byte between disk<>ram, either direction
		LDAX	D						; A = byte@DE
@inout:
		IN		DATA_PORT				; [read disk to A] or [write A to disk]  (might be IN or OUT based on STA @inout above)
		STAX	D						; byte@DE = A
		INX		D						; DE++
		DCX		H						; HL--
		MOV		A,H						; A = H
		ORA		L						; Z if HL=0
		RZ								; return when HL=0
		PUSH	H						; save HL
@pbb:
		LXI		H,0						; [pending_block_bytes]  HL = pending_block_bytes
		DCX		H						; HL--
		SHLD	pending_block_bytes		; pending_block_bytes = HL
		MOV		A,L						; A = L
		ORA		H						; Z if HL=0
		CZ		GetNextBlock			; CALL GetNextBlock when HL=0
		POP		H						; restore HL
		JMP		@move_byte				; next byte

; Get filename from user, reformat into FILNM1
InputFilenameWithPrompt:
		CALL	PTILL0					; print null-terminated string @ HL
		CALL	INLIN					; collect a line of input from user to KYBUF
		; HL = KYBUF-1
		; B = number of bytes entered + 1
		RC								; carryflag = user did Break / Ctrl+C -> abort
		DCR		B						; B-- ->  B=num_bytes
		RZ								; zeroflag = no bytes entered
		INX		H						; HL++ -> HL=KYBUF
		MOV		E,B						; E = number of bytes entered
		JMP		CKFN					; read HL=KYBUF, reformat to FILNM1, BC=FILNM2, HL=unchanged, DE=0, A=0

copyFX2toFX1:
		LXI		H,FX2					; HL @ start of ext of FILNM2
		LXI		D,FX1					; DE @ start of ext of FILNM1
		MOV		A,M						; A = (HL)
		STAX	D						; (DE) = A
		INX		H						; HL++
		INX		D						; DE++
		MOV		A,M						; A = (HL)
		STAX	D						; (DE) = A
		; FX1[0,1] = FX2[0,1]
		RET

Ask_Disk_Filename:
		CALL	InputFilenameWithPrompt	; get filename from user into FILNM1
; Search the disk for FILNM1. If found, copy FILNM1 to FILNM2
FindFILNM1onDisk:
		; init BlockNum & TmpBlockNum to 0
		XRA		A						; A = 0
		STA		BlockNum				; BlockNum = 0
		STA		TmpBlockNum				; TmpBlockNum = 0
		; generate the appropriate file attribute for the file type based on the filename ext
		LDA		FX1						; A = 1st byte of ext BA/CO/DO of FILNM1
		SUI		'B'						; A -= 'B'  (A=0..2 if ext is 'B'..'D')
		CPI		'D'-'B'+1				; carry if A>2  (ext is not 'B','C', or 'D')
		JNC		INR_A_RET				; if A>2 (invalid ext) then A++ & RET
		; if we're still here then A = 0,1,2 , ext is 'B','C','D'
										;           BA      CO      DO
										;     A =  0x00    0x01    0x02
		ADD		A						;     A =  0x00    0x02    0x04
		ADD		A						;     A =  0x00    0x04    0x08
		ADD		A						;     A =  0x00    0x08    0x10
		ADD		A						;     A =  0x00    0x10    0x20
		ADD		A						;     A =  0x00    0x20    0x40
		ADI		attrBA					;     A =  0x80    0xA0    0xC0
		STA		attr					; attr = attrBA attrCO attrDO
		; move disk to FCB table
		CALL	ReadStamp				; disk @ k0b2 (fcb1)
		; scan FCB table
@read_fcb:
		CALL	ReadBA					; read fcb, B=fcb_attr A=fcb_next
		STA		NextBlock				; NextBlock = A (fcb_next) (we don't know if we will care about this FCB, and NextBlock is not used anywhere in FindFILNM1onDisk, so it must just mean "the last FCB that was processed")
		LDA		BlockNum				; A = BlockNum (last block num processed, initially 0)
		INR		A						; A++
		JZ		INR_A_RET				; if BlockNum rolled past FF to 0 then A++ (just to clear the z flag I guess?) & RET
		; BlockNum still <= 0xFF
		STA		BlockNum				; BlockNum++
		MOV		A,B						; A = fcb_attr
		;
@fileattr:
		CPI		0x3F					; [attr]  compare fcb_attr to attr (0x3F overwritten by STA attr above)
		JNZ		@read_fcb				; repeat until fcb_attr == attr or scanned all fcbs
		; found a fcb with a matching attr
		; go to the corresponding block
		LDA		BlockNum				; A = BlockNum
		CALL	SelectBlock				; move disk to block BlockNum byte 0
		MVI		B,DFHDR_LEN				; B = RAMDSK file header len (10)
		LXI		H,DFHDR					; HL @ RAMDSK file header
		; copy header from disk to ram DFHDR buffer
@read_header:
		IN		DATA_PORT				; A = byte (of filename) , disk @ b++
		MOV		M,A						; M = byte
		INX		H						; HL++
		DCR		B						; B--
		JNZ		@read_header			; repeat while B>0
		; copied a file header from BlockNum on disk to DFHDR in ram
		MVI		C,CKFN_LEN				; C = 8  (6+2 CKFN formatted filename BBBBBBEE)
		LXI		H,DFHDR					; HL @ DFHDR
		LXI		D,FILNM1				; DE @ FILNM1
		CALL	CMPARE					; compare C bytes (or till null) of DE with HL, Z if match
		; if the filenames matched
		JZ		FILNM1toFILNM2			; if current disk filename matches FILENM1, then end scan and goto FILNM1toFILNM2
		; filenames did not match
		; try the next FCB
		CALL	ReadStamp				; move disk to FCB table
		LDA		BlockNum				; A = BlockNum
		MOV		C,A						; C = BlockNum
		CALL	ReadBAxC				; seek past the end of FCB BlockNum
		; ReadBAxC read up to and including FCB for current BlockNum, so
		; the disk is now sitting on the first byte of the FCB for BlockNum+1
		JMP		@read_fcb				; read and process next FCB

; copy FILNM1 to FILNM2
FILNM1toFILNM2:
		LXI		H,FILNM2				; HL = FILNM2
FILNM1toHL:								; copy 8 bytes from FILNM1 to HL
		LXI		D,FILNM1				; DE = FILNM1
		MVI		B,CKFN_LEN				; B = 8
		JMP		D2H4Bup					; copy 8 bytes from DE to FILNM2, RET

; Called when CopyBlocks reaches the end of a block.
; might be mis-named, since it only seems to be used for one block
; BlockNum gets updated to NextBlock but NextBlock isn't updated.
;
GetNextBlock:
		; reset pending_block_bytes counter to 1024
		LXI		H,DBLOCK_LEN			; HL = 1024 (full size blocks after the first)
		SHLD	pending_block_bytes		; pending_block_bytes = 1024
		; move disk to block 0 byte 0
		XRA		A						; A = 0
		CALL	SelectBlock				; disk @ k0b0
@nb:
		; update BlockNum with NextBlock
		MVI		A,0						; [NextBlock]  A = NextBlock  (0 just initial cond)
		STA		BlockNum				; BlockNum = NextBlock

		; ---- BlockNum is now replaced with NextBlock ----

@bn:
		MVI		A,0						; [BlockNum]  A = BlockNum  (0 just initial cond)
		CALL	SelectBlock				; disk @ BlockNum byte 0
		;
		; disk @ BlockNum byte 0
		; BlockNum = NextBlock
		; NextBlock NOT changed
		; pending_block_bytes = 1024
		RET

ReadStamp:
		XRA		A						; A = 0
		CALL	SelectBlock				; disk @ k0b0
		CALL	ReadBA					; B=k0b0 A=k0b1, disk @ k0b2
		ADD		B						; A += B
		CPI		StampByte0+StampByte1	; is the total 0x44?
		JNZ		FORMAT					; if not, ask to format
		RET								; disk @ k0b2, A=0x44, Z

; ReadBA C times. All but final read are discarded.
ReadBAxC:
		CALL	ReadBA					; read 2 bytes into B & A
		DCR		C						; C--
		JNZ		ReadBAxC				; repeat until C=0 (discard previous data)
		RET

; Read 2 bytes from disk into B & A, in that order
ReadBA:
		IN		DATA_PORT				; A = byte from disk, disk++
		MOV		B,A						; B = A
		IN		DATA_PORT				; A = byte from disk, disk++
		; B = byte0, A=byte1, disk advanced 2
		RET

PromptWithSure:
		CAll	ConfirmWithPrompt
		RNZ
ConfirmSure:
		LXI		H,strSure				; HL @ strSure
ConfirmWithPrompt:
		CALL	PTILL0					; print prompt
		CALL	CHGETUC					; wait for keypress, upcase
		MOV		L,A						; hold the normal keypress in B while we check F-keys
		LDA		KC7						; get status bits of keyboard matrix column 7 / F1-F8
		CPI		0x80					; F8
		JZ		MENU					; allow to escape format/repair loop to the main menu
		MOV		A,L						; A = normal keypress
		CPI		'Y'						; is it 'Y' ?
		RET								; return CPI flags

; get destination filename from user into FILNM1
Ask_Dest_Filename:
		LXI		H,strAs					; HL @ strAs
		CALL	InputFilenameWithPrompt	; get filename from user to FILNM1
		; Ignore what the user wrote for the destination filename extension
		; Take the source extension and copy it over the destination extension
		JMP		copyFX2toFX1			; overwrite FILNM1 ext with FILNM2 ext

;------------------------------------------------------------------------------
; FORMAT - prompt user to format and/or fix
;------------------------------------------------------------------------------
FORMAT:
		LXI		H,strFormat
		CALL	PromptWithSure
		JZ		@NewFormat
		LXI		H,strRepair
		CALL	PromptWithSure
		JZ		@WriteStamp
		JMP		MAIN

; write new format
@NewFormat:
		; since both TestRam and WriteFormat get the 128 value from D,
		; we could make it go in 8k chunks so the orignal old hardware
		; could have any number of 8k chips installed, and we'd correctly
		; show and enable exactly that much usable space.
		MVI		D,MinRam				; D = 128
		CALL	TestRam					; detect over 128k installed
		PUSH	B						; save B = 0x00 or 0x40
		; hw  > 128k: B = 0
		; hw <= 128k: B = 0x40

		; Write blank FCBs for the lower 128k.
		XRA		A						; A = 0
		CALL	SelectBlock				; disk @ k0b0
		MOV		B,A						; B = 0
		CALL	WriteFormat				; write B=0x00 A=0x00, 128 times

		; Write either blank or invalid FCBs for the upper 128k.
		; If the upper 128k does not exist, then write a special invalid attr
		; to those FCBs, which makes SAVE/LOAD/FREE/etc ignore those blocks.
		POP		B						; restore B = 0x00 or 0x40
		CALL	WriteFormat				; write B=0x00 A=0x00, or B=0x40 A=0x00,  128 times
		; disk block 0, bytes 256-511:
		; hw  > 128k: all 0x00 0x00
		; hw <= 128k: all 0x40 0x00
@WriteStamp:
		XRA		A						; A = 0
		CALL	SelectBlock				; disk @ k0b0
		MVI		A,StampByte0			; A = StampByte0
		OUT		DATA_PORT				; write stamp byte 0 @ k0b0
		MVI		A,StampByte1			; A = StampByte0
		OUT		DATA_PORT				; write stamp byte 0 @ k0b0
		JMP		MAIN					; restart at main

; write D copies of B A
WriteFormat:
		MOV		E,D						; E = D = 0x80
@l0:
		MOV		A,B						; A = B
		OUT		DATA_PORT				; disk = B
		XRA		A						; A = 0
		OUT		DATA_PORT				; disk+1 = 0
		DCR		E						; E--
		JNZ		@l0						; repeat until E=0
		RET

; Detect if the device doesn't have the full 256k of ram.
;
; This isn't about banks, it's about less than 256k (one full bank) installed.
; Original DATAPAC was sold with 128k or 256k.
; If the upper 128k is not installed, then cause FORMAT to mark the FCBs
; for those blocks with a non-empty yet also non-valid attr value (0x40),
; so that SAVE, LOAD, FREE, ListFiles, etc don't try to use those blocks.
;
; Perform a test write to the first byte above Dk (128k).
; Return B=0 for 256k, B=attrNoRam for 128k.
;
; No need to preserve the original data because this is only
; done during FORMAT and we're wiping all data anyway.
TestRam:
		; read k128b0 (the first byte above 128k)
		MOV		A,D						; A = D = 0x80
		CALL	SelectBlock				; disk @ k128b0
		IN		DATA_PORT				; A = orig_k128b0
		; save original value in B
		MOV		B,A						; B = orig
		; incriment and write back to the same k128b0
		MOV		A,D						; A = D = 0x80
		CALL	SelectBlock				; disk @ k128b0
		MOV		A,B						; A = orig
		INR		A						; A = incr
		OUT		DATA_PORT				; k128b0 = incr
		; read k128b0 again
		MOV		A,D						; A = D = 0x80
		CALL	SelectBlock				; disk @ k128b0
		IN		DATA_PORT				; A = test

		; B = orig
		; A = test (2nd read that should be orig+1)
		CMP		B						; test vs orig
		; if Z, that's a fail, test==orig, test should be orig+1
		MVI		B,attrNA				; B = 0x40
		RZ								; if test failed, return now with B = attrNA
		; test succeeded
		XRA		A						; A = 0
		MOV		B,A						; B = 0
		RET								; return B = 0

;------------------------------------------------------------------------------
; Find_NUM_BANKS
;------------------------------------------------------------------------------
;
; THIS IS HAIRY BUT WORKING
;
; The problem is to detect how many banks the hardware has,
; when banks that don't exist never the less still function.
;
; The only way to find out what the hardware really has is to write unique
; values to each possible bank and then go back and read them, and deduce
; which banks didn't really exist by how later writes overwrote earlier writes.
;
; == 1 ==
; Start at bank0 and count up to the highest possible bank.
; At each bank:
;  * read byte0 & save it to the stack to be restored later
;  * write the bank number to byte0
;
; == 2 ==
; *After* all banks written, in order, then read bank0.
; Derive NUM_BANKS_asc from whatever is in bank0.
; NUM_BANKS_asc = FIRST_BANK_asc + MAX_BANKS_asc-byte0
; (see table below for explaination)
;
; == 3 ==
; Count from MAX_BANKS_asc-1 down to NUM_BANKS_asc
; and for each of those (if any) pop & DISCARD one of the pushes from step 1.
; Count from NUM_BANKS_asc-1 down to FIRST_BANK_asc
; and for each of those pop & RESTORE one of the pushes from step 1
; back to the bank it came from.
;
;
; What happens when you write to all the different possible banks
; on all the different sized devices:
;
; D        : wrote D to bankD (blindly)
; MAX_BANKS_asc=4 : max possible NUM_BANKS_asc
; 256k-1M  : different size devices
; bank0-3  : where the write actually went
;
; example: when you try to write '3' to bank3 on a 512k device,
;          the '3' actually goes to bank1
;
;wrote 1bank  2bank  4bank
;  D    256k   512k  1M
;-------------------------
;  0   bank0  bank0  bank0
;  1   bank0  bank1  bank1
;  2   bank0  bank0  bank2
;  3   bank0  bank1  bank3
; MAX_BANKS_asc=4
;
; re-arrange above to show what data each bank contains after all the writes
; example: when you read bank1 you expect to get '1',
;          but on a 512k device, bank1 will contain '3'.
;
; read   size  size  size
; bank   256k  512k  1M
;-------------------------
; bank0   3     2     0
; bank1   3     3     1
; bank2   3     2     2
; bank3   3     3     3
;
; So we can see that bank0 supplies everything we need,
; it contains a different value for every possible case.
; 
; NUM_BANKS = MAX_BANKS-bank0
;
;           256k  512k  1M
; MAX_BANKS  4     4     4
;   - bank0  3     2     1
; ------------------------
; NUM_BANKS  1     2     4
;
; and taking the ascii into account that becomes
; NUM_BANKS_asc = FIRST_BANK_asc + MAX_BANKS_asc-bank0

; conditions this must handle:
; * no device connected
; * 256k, 512k, 1M device
; * already formatted / not formatted
; * preserve pre-existing data

; Test the hardware to determine NUM_BANKS_asc
; Does a test-write to byte0 of every possible bank.
; Saves and restores the pre-existing data.
Find_NUM_BANKS:

	; debugging works by writing to strTitle  A=value, STAX B, INX B
	IF DEBUG
		LXI		B,strTitle				; BC = start of strTitle
	ENDIF

		;----------------------------------------------------------------------
		; == 1 == | Write the bank number to each bank
		;----------------------------------------------------------------------

		MVI		H,MAX_BANKS_asc			; H = '4'
		MVI		L,FIRST_BANK_asc		; L = '0'
		MOV		D,L						; D = '0'  bank number
		DCR		D						; D = '0'-1

@TestWrite:								; test write & read
		INR		D						; D++
		MOV		A,D						; A = D = bank

	IF DEBUG
		STAX	B						; write bank number to debug
		INX		B						; advance the debug pointer
	ENDIF

		; move to bank D
		CALL	SelectBank				; disk @ bank D block 0 byte 0

		; read the pre-existing data and save it
		IN		DATA_PORT				; A = original data
		PUSH	PSW						; stack the original data
		XRA		A						; A = 0
		CALL	SelectBlock				; move back to byte 0

		; write bank number to byte 0
		MOV		A,D						; A = bank
		OUT		DATA_PORT				; write byte 0 = Dwrite = bank

		INR		A						; A++  (A=D+1)
		CMP		H						; D+1 vs MAX_BANKS_asc
		JM		@TestWrite				; repeat while bank+1 < highest+1

		;----------------------------------------------------------------------
		; == 2 == | Read bank 0, calculate & store NUM_BANKS_asc
		;----------------------------------------------------------------------

		; The above table of expected data applies now.

		; read bank0
		MOV		A,L						; A = FIRST_BANK_asc
		CALL	SelectBank				; move to bank 0
		IN		DATA_PORT				; A = test0

		; If IN returns the port number itself when you know that the data
		; should be something else, that means there is no device connected.
		; This works but it's better UX to allow the non-working Format prompt.
		;CPI		DATA_PORT
		;JZ		MENU

	IF DEBUG
		; debug test0
		STA		DBG_T
	ENDIF

		; Find NUM_BANKS_asc = MAX_BANKS_asc-test0
		MOV		E,A						; E = test0
		MOV		A,H						; A = MAX_BANKS_asc
		SUB		E						; A = MAX_BANKS_asc-test0
		ADD		L						; A+=FIRST_BANK_asc = '0'+difference
		STA		NUM_BANKS_asc			; NUM_BANKS_asc = A = '0'+difference

		;----------------------------------------------------------------------
		; == 3 == | Restore the original data to all banks
		;----------------------------------------------------------------------

		; pop & discard the reads from MAX_BANKS_asc down to NUM_BANKS_asc if any,
		; then pop & restore the rest of the reads to the banks they came from.

		MOV		E,A						; E = NUM_BANKS_asc (number of actual banks)
		MOV		D,H						; D = MAX_BANKS_asc (number of possible banks)
@pop_test0:
		DCR		D						; D-- D = counter from max down to 0
		MOV		A,D						; A = D
		CMP		L						; D vs FIRST_BANK_asc
		RM								; RETURN when D < FIRST_BANK_asc
		; D >= FIRST_BANK_asc (D might be a real bank or might be above highest real bank)
		POP		B						; pop AF(bank D byte 0) to BC B=data C=junk
		CMP		E						; D vs NUM_BANKS_asc
		JP		@pop_test0				; discard & repeat until D < NUM_BANKS_asc
		; FIRST_BANK_asc <= D < NUM_BANKS_asc (D is a real bank number)
		CALL	SelectBank				; move disk to bank D block 0 byte 0
		MOV		A,B						; A = B = original data from bank D
		OUT		DATA_PORT				; write original data back to bank D
		JMP		@pop_test0				; next D

;------------------------------------------------------------------------------
; BANK - switch banks
;------------------------------------------------------------------------------
; FIRST_BANK_asc = ASCII lowest bank number
; NUM_BANKS_asc  = ASCII highest bank number + 1
; strBankNum     = ASCII current/target bank number
BANK:
		; increment or roll-over bank number
		; This part just does the incriment-or-rollover logic on BankNum.
		; Fall-through to SelectBank to actually do the work.
	IF DEBUG
		; for debug, NUM_BANKS_asc is simply stored right in strTitle
		LDA		NUM_BANKS_asc			; A = NUM_BANKS_asc
		MOV		B,A						; B = nbanks
	ELSE
@nbanks: ; operand is NUM_BANKS_asc, FIRST_BANK_asc is just the initial value
		MVI		B,FIRST_BANK_asc		; [NUM_BANKS_asc] B = NUM_BANKS_asc
	ENDIF
		LDA		strBankNum				; A = current bank
		INR		A						; A = current+1
		CMP		B						; A vs nbanks
		JC		SelectBank				; if A < nbanks then use it
		MVI		A,FIRST_BANK_asc		; if A >= nbanks then set A = bank0

; FALL THROUGH

;------------------------------------------------------------------------------
; SelectBank - Set strBankNum and ctl_port, SelectBlock 0
;------------------------------------------------------------------------------
; in:
;   A = ASCII bank number
; out:
;   store strBankNum = A
;   calculate & store ctl_port number from A
;   fall through to SelectBlock to actually set the hardware
; 
; Intentionally no validity-checking here. This is also used while
; probing the hardware to determine what's valid in the first place.
SelectBank:
		STA		strBankNum				; store target bank number ASCII
	IF DEBUG
		PUSH	B
	ENDIF
		SUI		FIRST_BANK_asc-1		; A = not-ascii target bank + 1
		MOV		C,A						; C = not-ascii target bank + 1
		MVI		A,CTRL_PORT-CTRL_STEP	; A = control port for bank0 - step
@step_ctl_port:
		ADI		CTRL_STEP				; A += step
		DCR		C						; C--
		JNZ		@step_ctl_port			; repeat until C=0
		STA		ctl_port				; store control port for target bank
	IF DEBUG
		STA		DBG_P
		POP		B
	ENDIF
		XRA		A						; A = 0

; FALL THROUGH

;------------------------------------------------------------------------------
; SelectBlock - Select block# in the current bank
;------------------------------------------------------------------------------
; Write A out to whatever port number is currently in ctl_port.
; Moves the disk to block A byte 0 in whatever bank ctl_port applies to.
SelectBlock: ; operand is ctl_port, CTRL_PORT is just the initial value
		OUT		CTRL_PORT				; [ctl_port]  write A to ctl_port
		RET

;------------------------------------------------------------------------------
; strings & variables
;------------------------------------------------------------------------------

KFREE_COL				EQU		32				; KB free column position

strUI:
		cursor_invisible
		unprotect_labels						; clear the effect of pressing Label twice
		disable_automatic_scroll
		DB FF
		enter_reverse_mode
strTitle:
	IF DEBUG
DBG_T					EQU		strTitle+33
DBG_K					EQU		strTitle+36
DBG_P					EQU		strTitle+39
		DB "                       B  N     T  K  P "
	ELSE ; !DEBUG
		DB "NODE RAMPAC/DATAPAC Bank   P.Globman/BKW"
	ENDIF ; DEBUG
		exit_attribute_mode
		cursor_address NROWS,1
;		DB "F1-- F2-- F3-- F4-- F5-- F6-- F7-- F8--"
		DB "Bank Load Save Name Kill           Menu"
		cursor_address NROWS-1,KFREE_COL+3
		DB "K free"
		cursor_address 1,1
		DB 0

strFree:
		cursor_address NROWS-1,KFREE_COL
		DB 0

strKill:
		cursor_address NROWS-1,1
		DB "Kill:",0

strLoad:
		cursor_address NROWS-1,1
		DB "Load:",0

strSave:
		cursor_address NROWS-1,1
		DB "Save:",0

strName:
		cursor_address NROWS-1,1
		DB "Name:",0

strAs:
		clr_eol
		DB "  as:",0

strReplace:
		cursor_address NROWS,19
		DB "Replace?",0

strFormat:
		cursor_address NROWS-1,1
		clr_eol
		DB "Format?",0

strRepair:
		cursor_address NROWS-1,1
		clr_eol
		DB "Repair?",0

strSure:
		clr_eol
		DB "Sure?",0

; If we didn't care about TOP/END in RBOOT.BA, the binary could be smaller,
; and start 2 bytes higher besides, while adding more complicated bank support.
	IF MATCH_LEGACY_CO_HEADER

; Manually adjust this so that the 100 binary compiles to 1406 bytes to match
; the legacy binary. This also takes care of the 200 version at the same time.
padding:
		DS 6

	ENDIF ; MATCH_LEGACY_CO_HEADER

PRGEND:
