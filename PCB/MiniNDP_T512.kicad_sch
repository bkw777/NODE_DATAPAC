	(text "CR2032 - 7-13 years, 4.1mm thick:\nBT1 = Keystone 3034\nC1 = TAJC227K010RNJ - 6032-28 220u 10v\n\nCR2016 - 3-7 years, 1.7mm thick:\nBT1 = Keystone 3028\nC1 = TLJW157M010R0200 - 6032-15 150u 10v\n\n128k or 256k:  OMIT U5 U6, CLOSE JP1 JP2\n\n512k:  OPEN JP1 JP2\n\n"
