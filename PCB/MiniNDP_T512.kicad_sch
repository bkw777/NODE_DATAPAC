	(text "	    BUS  BUS  BUS\n(A)	~{YO}  _A8   _A9  _A10  ->  ~{BLOCK} ~{BYTE}    Function\n L	 X	 X	 X	 X		  X	   X\n X	 H	 X	 X	 X		  X	   X\n X	 X	 L	 X	 X		  X	   X\n H	 L	 H	 L	 L	->    L	   H	Select BLOCK # from BANK 0\n H	 L	 H	 L	 H	->    L	   H	Select BLOCK # from BANK 1\n H	 L	 H	 H	 X	->    H	   L	Read or Write BYTE\n\n~{BLOCK}\nL: sets A0-A9 to 0, updates A10-A18 from AD0-AD7 & BUS_A10\nH: latches A10-A18\n\n~{BYTE}\nL: enables SRAM for read or write\nH: disables SRAM, increments A0-A9 by 1\n"
		(exclude_from_sim no)
		(at 16.51 193.04 0)
		(effects
